# Virtual environments
.venv/
venv/
env/

# IDE
.idea/
.vscode/
.claude/
.agents/
*.iml

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
*.spec.bak

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# PyInstaller / installer output
installer/output/
*.exe
*.msi
*.msix
*.exe.manifest

# Sekrety i lokalne poświadczenia
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# Raporty użytkownika i pliki systemowe
raport*.html
raport*.csv
.DS_Store
Thumbs.db
Desktop.ini
*.tmp
*.bak

# Local scratch
scratch/
*.log

# Input documents are local data, never source assets.
*.[pP][dD][fF]

# Example documents remain local; regenerate with scripts/generate_fixtures.py.
/examples/

# Keep only the current installer and its checksum in the repository.
!installer/output/
installer/output/*
!installer/output/Signum-Setup-1.1.3.exe
!installer/output/Signum-Setup-1.1.3.exe.sha256
